.venv/
__pycache__/
*.pyc

# Patient data (PHI) and encryption keys — NEVER commit, even encrypted.
app/storage/*.db
app/storage/*.db.enc
app/storage/.keyfile
app/storage/.runtime/
*.db
*.sqlite
*.sqlite3

# Eval harness output (generated notes from the synthetic corpus — regenerable, noisy diffs).
evals/runs/
# Per-sweep scored results. Regenerable and machine-written; commit one deliberately if you want
# a baseline to diff future runs against (scripts/eval_compare.py).
evals/results/
# Any corpus file holding REAL dictation rather than synthetic records. The synthetic
# corpus in evals/data/*.jsonl IS committed so eval results are reproducible.
evals/data/*.local.jsonl

# Third-party credentials / secrets.
app/integrations/.sheets_credentials.json
app/integrations/sheets_config.yaml
app/transcribe/hf_config.yaml
*.pem
*.key

# Editor / tooling local state (keep the shared .claude/settings.json).
.claude/settings.local.json
.claude/*.lock
.pytest_cache/
.DS_Store
Thumbs.db
